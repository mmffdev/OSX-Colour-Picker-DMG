<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The App Sandbox, which the Mac App Store requires. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- WebKit requires its network service even for bundled offline HTML help. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Folders and files the user picks in an open or save panel, or drops on the app. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- Keeping hold of those folders between launches: sync, projects, a moved data home. -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>
</dict>
</plist>
